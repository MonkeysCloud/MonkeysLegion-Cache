# MonkeysLegion Cache Configuration
# Cache system configuration using .mlc format

# Default cache store to use
cache.default = env("CACHE_DRIVER", "file")

# Global cache key prefix
cache.prefix = env("CACHE_PREFIX", "ml_cache")

# File Cache Store Configuration
cache.stores.file.driver = "file"
cache.stores.file.path = env("CACHE_PATH", "storage/cache")
cache.stores.file.prefix = env("CACHE_PREFIX", "ml_cache")

# Redis Cache Store Configuration
cache.stores.redis.driver = "redis"
cache.stores.redis.host = env("REDIS_HOST", "127.0.0.1")
cache.stores.redis.password = env("REDIS_PASSWORD", null)
cache.stores.redis.port = env("REDIS_PORT", 6379)
cache.stores.redis.database = env("REDIS_CACHE_DB", 1)
cache.stores.redis.prefix = env("CACHE_PREFIX", "ml_cache")
cache.stores.redis.timeout = env("REDIS_TIMEOUT", 0.0)

# Memcached Cache Store Configuration
cache.stores.memcached.driver = "memcached"
cache.stores.memcached.persistent_id = env("MEMCACHED_PERSISTENT_ID", null)
cache.stores.memcached.prefix = env("CACHE_PREFIX", "ml_cache")
cache.stores.memcached.servers.0.host = env("MEMCACHED_HOST", "127.0.0.1")
cache.stores.memcached.servers.0.port = env("MEMCACHED_PORT", 11211)
cache.stores.memcached.servers.0.weight = 100

# Array Cache Store Configuration (for testing)
cache.stores.array.driver = "array"
cache.stores.array.prefix = env("CACHE_PREFIX", "ml_cache")

# Cache Configuration Options
cache.options.serialize = true
cache.options.compression = false

# Default TTL values (in seconds)
cache.ttl.default = env("CACHE_DEFAULT_TTL", 3600)
cache.ttl.short = 300
cache.ttl.medium = 1800
cache.ttl.long = 86400
cache.ttl.week = 604800

# Cache Tags Configuration
cache.tags.enabled = true
cache.tags.separator = ":"

# Cache Features
cache.features.remember = true
cache.features.atomic = true
cache.features.tagging = true
cache.features.monitoring = env("CACHE_MONITORING", false)
