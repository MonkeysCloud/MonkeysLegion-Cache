{
    "name": "monkeyscloud/monkeyslegion-cache",
    "description": "Cache package for MonkeysLegion Framework with multiple drivers support",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "MonkeysCloud",
            "email": "jorge@monkeyscloud.com"
        }
    ],
    "require": {
        "php": "^8.4",
        "psr/simple-cache": "^3.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0"
    },
    "suggest": {
        "ext-redis": "Required to use Redis cache driver",
        "ext-memcached": "Required to use Memcached cache driver",
        "monkeyscloud/monkeyslegion-mlc": "For .mlc configuration file support with environment variables",
        "monkeyscloud/monkeyslegion-cli": "For CLI commands"
    },
    "autoload": {
        "psr-4": {
            "MonkeysLegion\\Cache\\": "src/",
            "MonkeysLegion\\Cache\\CLI\\": "src/CLI/"
        },
        "files": [
            "src/helpers.php"
        ]
    },
    "extra": {
        "branch-alias": {
            "dev-main": "1.0.x-dev"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "MonkeysLegion\\Cache\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}