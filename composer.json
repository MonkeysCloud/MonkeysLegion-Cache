{
    "name": "monkeyscloud/monkeyslegion-cache",
    "description": "High-performance cache package for MonkeysLegion Framework with multiple drivers, atomic locks, encrypted serialization, and tiered caching",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "MonkeysCloud",
            "email": "jorge@monkeyscloud.com"
        }
    ],
    "require": {
        "php": "^8.4",
        "psr/simple-cache": "^3.0",
        "psr/log": "^3.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "suggest": {
        "ext-redis": "Required to use Redis cache driver and distributed locks",
        "ext-memcached": "Required to use Memcached cache driver",
        "ext-igbinary": "For igbinary serialization (30-50% smaller payloads)",
        "ext-sodium": "Required for encrypted cache serialization (GDPR/PCI)",
        "monkeyscloud/monkeyslegion-mlc": "For .mlc configuration file support with environment variables"
    },
    "autoload": {
        "psr-4": {
            "MonkeysLegion\\Cache\\": "src/"
        },
        "files": [
            "src/helpers.php"
        ]
    },
    "extra": {
        "branch-alias": {
            "dev-2.1": "2.1.x-dev"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "MonkeysLegion\\Cache\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}